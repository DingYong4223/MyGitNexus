{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mygitnexus-hook.js\"",
            "timeout": 10,
            "statusMessage": "Enriching with MyGitNexus graph context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mygitnexus-hook.js\"",
            "timeout": 10,
            "statusMessage": "Checking MyGitNexus index freshness..."
          }
        ]
      }
    ]
  }
}
