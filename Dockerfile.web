ARG BUILDPLATFORM
ARG TARGETPLATFORM
# Pinned npm version — keep in sync with Dockerfile.cli and
# mygitnexus/Dockerfile.test.
ARG NPM_VERSION=11.14.1

# node:22-bookworm-slim
FROM --platform=$BUILDPLATFORM node:26-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS builder
ARG NPM_VERSION

WORKDIR /app

RUN npx --yes npm@${NPM_VERSION} install -g npm@${NPM_VERSION}

COPY mygitnexus-shared/package.json mygitnexus-shared/package-lock.json ./mygitnexus-shared/
RUN npm ci --prefix mygitnexus-shared

COPY mygitnexus-shared ./mygitnexus-shared
RUN npm run build --prefix mygitnexus-shared

COPY mygitnexus/package.json ./mygitnexus/

COPY mygitnexus-web/package.json mygitnexus-web/package-lock.json ./mygitnexus-web/
RUN npm ci --prefix mygitnexus-web

COPY mygitnexus-web ./mygitnexus-web
RUN npm run build --prefix mygitnexus-web

# node:22-bookworm-slim
FROM node:26-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341 AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -rf /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

WORKDIR /app

COPY --from=builder /app/mygitnexus-web/dist ./dist
COPY docker-server.mjs ./docker-server.mjs

RUN chown -R node:node /app

USER node

EXPOSE 4173

CMD ["node", "docker-server.mjs"]
